# Java poker examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI container jobs

set shell := ["bash", "-c"]

ROOT := `git rev-parse --show-toplevel`

default:
    @just --list

# Proto generation runs the gradle protobuf plugin from the included build.
# The plugin is the EXECUTOR; the trigger (mtime guard, lefthook, recipe
# deps) lives in the host-side justfile per project_proto_generation_model.
generate-proto-force:
    ./gradlew --no-daemon :angzarr-client-java:proto:generateProto

# Back-compat aliases (and legacy `proto-gen` from the old container script).
generate-proto: generate-proto-force
proto: generate-proto-force
proto-gen: generate-proto-force

build: generate-proto-force
    ./gradlew build -x test

build-dev: generate-proto-force
    ./gradlew build -x test --info

test-unit: generate-proto-force
    ./gradlew test

test-acceptance: generate-proto-force
    PLAYER_URL="${PLAYER_URL:-localhost:1310}" \
    TABLE_URL="${TABLE_URL:-localhost:1311}" \
    HAND_URL="${HAND_URL:-localhost:1312}" \
    ./gradlew :tests:cucumberAcceptanceTest

test: generate-proto-force
    ./gradlew test

fmt:
    ./gradlew spotlessApply || echo "Spotless not configured, skipping format"

lint: generate-proto-force
    ./gradlew check -x test

# Run PIT mutation testing on tournament handlers
mutation-test: generate-proto-force
    ./gradlew :tournament-agg:pitest

deps:
    ./gradlew dependencies --configuration compileClasspath

wrapper-update:
    ./gradlew wrapper --gradle-version latest

# Auto-format code (google-java-format)
fmt-fix:
    #!/usr/bin/env bash
    JAR="/tmp/google-java-format.jar"
    if [ ! -f "$JAR" ]; then
        curl -sL -o "$JAR" "https://github.com/google/google-java-format/releases/download/v1.25.2/google-java-format-1.25.2-all-deps.jar"
    fi
    find . -name "*.java" -not -path "*/build/*" -not -path "*/angzarr-*/*" | xargs java -jar "$JAR" --replace
